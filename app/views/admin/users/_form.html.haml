= simple_form_for @form, url: action_url, html: { method: method, class: '', data: { turbo: "false" } } do |f|
  = f.input :email if ['new', 'create'].include?(action_name)
  = f.input :user_name
  = f.input :first_name
  = f.input :last_name
  = f.input :admin, as: :boolean

  .row.mt-sm
    .col-sm-12.text-center
      = f.button :submit, t('views.shared.save'), class: 'btn-sm btn-info text-center'
      = link_to t('views.shared.cancel'), admin_users_path