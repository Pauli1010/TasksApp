%header
  %nav{ class: 'navbar navbar-expand-lg navbar-dark bg-dark' }
    = link_to 'TasksApp', root_path, class: 'navbar-brand'
    %button.navbar-toggler{ type: 'button', data: { toggle: 'collapse', target: '#mainMenu' }, aria: { controls: 'mainMenu', expanded: 'false', label: 'Toggle navigation' }}
      %span.navbar-toggler-icon

    #mainMenu.collapse.navbar-collapse
      %ul.navbar-nav.mr-auto
        %li.nav-item.dropdown
          = link_to t('.assets'), '', class: "#{menu_is_active('tasks')} nav-item nav-link", id: 'assets-dropdown-menu-link', role: 'button', data: { toggle: 'dropdown' }, aria: { haspopup: true, expanded: false }
          %div.dropdown-menu{ aria: {labelledby: 'assets-dropdown-menu-link' }}
            = link_to t('.tasks'), tasks_path, class: "#{menu_is_active('tasks')} dropdown-item"
        - if current_user.admin?
          %li.nav-item.dropdown
            = link_to t('.admin_dashboard'), '', class: "#{admin_dashboard_scope?} nav-item nav-link", id: 'admin-dropdown-menu-link', role: 'button', data: { toggle: 'dropdown' }, aria: { haspopup: true, expanded: false }
            %div.dropdown-menu{ aria: { labelledby: 'admin-dropdown-menu-link' }}
              = link_to t('.dictionaries'), admin_dictionaries_path, class: "#{menu_is_active('dictionaries') || menu_is_active('dictionary_items')} dropdown-item"
              = link_to t('.users'), admin_users_path, class: "#{menu_is_active('users')} dropdown-item"


      %ul.navbar-nav.navbar-right
        %li.nav-item.dropdown.drop-to-right
          = link_to user_avatar(current_user), account_path, class: "#{account_scope?} nav-link pb-0", id: 'user-dropdown-menu-link', role: 'button', data: { toggle: 'dropdown' }, aria: { haspopup: true, expanded: false }
          %div.dropdown-menu{ aria: { labelledby: 'user-dropdown-menu-link' }}
            = link_to t('account.show.title'), account_path, class: "#{menu_is_active('account')} dropdown-item"
        %li.nav-item
          = link_to logout_path, class: 'nav-link' do
            = bootstrap_icon 'door-open', width: 20, height: 20
